# =============================================================================
# Mushk Perfumes: PRODUCTION settings for the Contabo server.
# On the server:  cp .env.example .env && nano .env
# docker-compose.yml reads this file. Never commit the real .env.
#
# Write values without quotes and without spaces around "=".
# (For local development use apps/web/.env.example instead.)
# =============================================================================

# -----------------------------------------------------------------------------
# Domain + HTTPS (Caddy gets a Let's Encrypt certificate automatically)
# DOMAIN is the bare domain; www.DOMAIN redirects to it.
# Point both A records (@ and www) to the server IP BEFORE the first deploy.
# No domain yet? Use  <server-ip-with-dashes>.sslip.io, e.g. 203-0-113-10.sslip.io
# -----------------------------------------------------------------------------
DOMAIN=mushkscents.com
ACME_EMAIL=you@example.com

# -----------------------------------------------------------------------------
# Postgres (runs in Docker on the same server)
# Use a long random password, letters/digits only:  openssl rand -hex 24
# The app's DATABASE_URL is built from these in docker-compose.yml.
# -----------------------------------------------------------------------------
POSTGRES_DB=mushk
POSTGRES_USER=mushk
POSTGRES_PASSWORD=

# -----------------------------------------------------------------------------
# NextAuth (admin login).  Generate:  openssl rand -base64 32
# NEXTAUTH_URL is set automatically to https://DOMAIN.
# -----------------------------------------------------------------------------
NEXTAUTH_SECRET=

# First admin user: used only by the seed:admin command (see DEPLOY.md).
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Mushk Admin

# -----------------------------------------------------------------------------
# Stripe. The publishable key is baked into the build, so redeploy after
# changing it. Webhook endpoint: https://DOMAIN/api/webhooks/stripe
# Events: checkout.session.completed, checkout.session.expired, charge.refunded
# -----------------------------------------------------------------------------
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Cloudinary (product image uploads)
# -----------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# -----------------------------------------------------------------------------
# Email (order confirmations, new-order alerts, contact form) via Gmail SMTP.
# SMTP_PASS is a Gmail *App Password* (16 characters), not the normal password:
#   Google Account -> Security -> 2-Step Verification (turn on) -> App passwords
# New-order alerts and contact messages go to ORDER_NOTIFY_EMAIL / the store
# email in Admin -> Site Content. Leave SMTP_PASS empty to disable sending.
# -----------------------------------------------------------------------------
SMTP_USER=mushk.scents1@gmail.com
SMTP_PASS=
MAIL_FROM=Mushk Perfumes <mushk.scents1@gmail.com>
ORDER_NOTIFY_EMAIL=mushk.scents1@gmail.com

TZ=Asia/Karachi
