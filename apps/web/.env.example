# =============================================================================
# Mushk Perfumes: LOCAL DEVELOPMENT settings.
# Copy to apps/web/.env.local. The db scripts (migrate, seed) read it too.
# (Production settings live in the root .env.example.)
# =============================================================================

NEXT_PUBLIC_DOMAIN=http://localhost:3000

# Postgres. Start a local one with `npm run db:up` (docker-compose.dev.yml).
DATABASE_URL=postgres://mushk:mushk@localhost:5432/mushk

# NextAuth (admin login). Generate a secret: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# First admin user (used by `npm run seed:admin`)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please
ADMIN_NAME=Mushk Admin

# Stripe test keys: https://dashboard.stripe.com/test/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Cloudinary (optional locally; without it, paste image URLs by hand)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
