{
  "name": "mushk",
  "version": "0.1.1",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @mushk/web",
    "build": "npm run build -w @mushk/web",
    "start": "npm run start -w @mushk/web",
    "lint": "npm run lint -w @mushk/web",
    "db:up": "docker compose -f docker-compose.dev.yml up -d",
    "db:down": "docker compose -f docker-compose.dev.yml down",
    "db:generate": "npm run generate -w @mushk/db",
    "db:migrate": "npm run migrate -w @mushk/db",
    "db:studio": "npm run studio -w @mushk/db",
    "seed:admin": "npm run seed:admin -w @mushk/db",
    "seed:products": "npm run seed:products -w @mushk/db",
    "seed:catalog": "npm run seed:catalog -w @mushk/db",
    "db:backup": "npm run backup -w @mushk/db --",
    "db:restore": "npm run restore -w @mushk/db --",
    "seed:blog": "npm run seed:blog -w @mushk/db"
  }
}
